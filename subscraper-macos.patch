diff --git a/scripts/package-macos.sh b/scripts/package-macos.sh
new file mode 100755
index 0000000..1d06bda
--- /dev/null
+++ b/scripts/package-macos.sh
@@ -0,0 +1,61 @@
+#!/usr/bin/env bash
+#
+# Assemble SubScraper.app for macOS from a `dotnet publish -r osx-arm64`
+# (or osx-x64) output directory.
+#
+# Usage:
+#   scripts/package-macos.sh <publish-dir> <version> [output-dir]
+#
+#   <publish-dir>  dotnet publish output, e.g. outosx-arm64-gui
+#   <version>      release version, e.g. 1.9.20 (goes into Info.plist)
+#   [output-dir]   directory in which SubScraper.app is created (default: .)
+#
+# This script only copies files and writes Info.plist, so it runs on any OS
+# (Linux CI included). Code signing and notarization must happen afterwards
+# on a Mac with an Apple Developer ID (see docs/installation/macos.md).
+
+set -euo pipefail
+
+PUBLISH_DIR="${1:?usage: package-macos.sh <publish-dir> <version> [output-dir]}"
+VERSION="${2:?usage: package-macos.sh <publish-dir> <version> [output-dir]}"
+OUT_DIR="${3:-.}"
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+
+APP_DIR="$OUT_DIR/SubScraper.app"
+CONTENTS_DIR="$APP_DIR/Contents"
+MACOS_DIR="$CONTENTS_DIR/MacOS"
+RESOURCES_DIR="$CONTENTS_DIR/Resources"
+
+if [ ! -d "$PUBLISH_DIR" ]; then
+    echo "error: publish directory not found: $PUBLISH_DIR" >&2
+    exit 1
+fi
+
+rm -rf "$APP_DIR"
+mkdir -p "$MACOS_DIR" "$RESOURCES_DIR"
+
+# 1. Published binaries and content (Avalonia assets, .playwright drivers,
+#    chromium-scripts, rules.json, ...).
+cp -R "$PUBLISH_DIR/." "$MACOS_DIR/"
+
+# 2. Keep only the macOS Playwright drivers.
+rm -rf "$MACOS_DIR/.playwright"/node/win* "$MACOS_DIR/.playwright"/node/linux*
+
+# 3. Friendly executable name (matches CFBundleExecutable in Info.plist).
+if [ -f "$MACOS_DIR/SubScraper.Gui" ]; then
+    mv "$MACOS_DIR/SubScraper.Gui" "$MACOS_DIR/SubScraper"
+fi
+
+# 4. Info.plist with the release version.
+sed -e "s/@VERSION@/$VERSION/g" "$SCRIPT_DIR/Info.plist" > "$CONTENTS_DIR/Info.plist"
+
+# 5. Icon (optional: drop a SubScraper.icns next to this script to include it).
+if [ -f "$SCRIPT_DIR/SubScraper.icns" ]; then
+    cp "$SCRIPT_DIR/SubScraper.icns" "$RESOURCES_DIR/SubScraper.icns"
+fi
+
+# 6. Drop debug symbols and ensure the executable bit survives tar transport.
+rm -f "$MACOS_DIR"/*.pdb
+chmod +x "$MACOS_DIR/SubScraper"
+
+echo "Created $APP_DIR"
